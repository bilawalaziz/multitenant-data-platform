# grafana chart (grafana-community: the grafana/grafana chart is deprecated). Datasources and the dashboard of infra/grafana (the dashboard is read from the file itself).
fullnameOverride: grafana

resources:
  requests: {cpu: 50m, memory: 128Mi}
  limits: {memory: 256Mi}

# The admin password is generated by the chart (Secret grafana); read it with
#   kubectl -n observability get secret grafana -o jsonpath='{.data.admin-password}' | base64 -d
grafana.ini:
  users:
    allow_sign_up: false
  auth.anonymous:
    enabled: true
    org_role: Viewer
  analytics:
    reporting_enabled: false
    check_for_updates: false

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        uid: prometheus
        type: prometheus
        access: proxy
        url: http://prometheus-server.observability
        isDefault: true
        editable: false
      - name: Tempo
        uid: tempo
        type: tempo
        access: proxy
        url: http://tempo.observability:3200
        editable: false

dashboardProviders:
  dashboardproviders.yaml:
    apiVersion: 1
    providers:
      - name: sensor-platform
        orgId: 1
        folder: Sensor Platform
        type: file
        disableDeletion: false
        allowUiUpdates: true
        options:
          path: /var/lib/grafana/dashboards/sensor-platform

dashboards:
  sensor-platform:
    ingestion-platform:
      json: |
{{ readFile "../../infra/grafana/dashboards/ingestion-platform.json" | indent 8 }}

persistence:
  enabled: true
  size: 1Gi
