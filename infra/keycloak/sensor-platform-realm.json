{
  "realm": "sensor-platform",
  "enabled": true,
  "displayName": "Sensor Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Platform operator"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant administrator"
      },
      {
        "name": "tenant-ingest",
        "description": "Tenant ingestion client"
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant ID\", \"validations\": {\"length\": {\"max\": 64}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "platform-cli",
      "name": "Platform CLI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "sensor-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sensor-platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sensor-platform-provisioner",
      "name": "Device credential provisioner",
      "description": "Used by the platform to create and manage per-device clients; it holds no API roles and no audience, so it cannot call the platform API.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PROVISIONER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "kc-admin-api",
        "roles",
        "basic"
      ]
    },
    {
      "clientId": "tenant-alpha-ingest",
      "name": "Tenant alpha ingestion client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ALPHA_INGEST_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "tenant-alpha",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "sensor-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sensor-platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenant-beta-ingest",
      "name": "Tenant beta ingestion client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BETA_INGEST_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "tenant-beta",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "sensor-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sensor-platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "platform-admin@sensor-platform.local",
      "firstName": "Platform",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin"
      ],
      "requiredActions": []
    },
    {
      "username": "alpha-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "alpha-admin@sensor-platform.local",
      "firstName": "Alpha",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tenant-admin"
      ],
      "requiredActions": [],
      "attributes": {
        "tenant_id": [
          "tenant-alpha"
        ]
      }
    },
    {
      "username": "beta-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "beta-admin@sensor-platform.local",
      "firstName": "Beta",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tenant-admin"
      ],
      "requiredActions": [],
      "attributes": {
        "tenant_id": [
          "tenant-beta"
        ]
      }
    },
    {
      "username": "service-account-sensor-platform-provisioner",
      "enabled": true,
      "serviceAccountClientId": "sensor-platform-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-clients",
          "manage-realm",
          "manage-users"
        ]
      }
    },
    {
      "username": "service-account-tenant-alpha-ingest",
      "enabled": true,
      "serviceAccountClientId": "tenant-alpha-ingest",
      "realmRoles": [
        "tenant-ingest"
      ]
    },
    {
      "username": "service-account-tenant-beta-ingest",
      "enabled": true,
      "serviceAccountClientId": "tenant-beta-ingest",
      "realmRoles": [
        "tenant-ingest"
      ]
    }
  ]
}
