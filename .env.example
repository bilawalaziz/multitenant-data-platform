# Throwaway demo values for local development only. Copy to .env (git-ignored)
# and change every secret before using this anywhere else.

# Postgres
POSTGRES_DB=sensor_platform
POSTGRES_USER=sensor
POSTGRES_PASSWORD=sensor_dev_pw
POSTGRES_HOST_PORT=5433
# Role the application connects as (no ownership, subject to row-level security); created on first start of the volume.
DB_APP_USER=sensor_app
DB_APP_PASSWORD=sensor_app_dev_pw
# Owner credentials Flyway migrates with. Compose uses POSTGRES_USER/POSTGRES_PASSWORD for these; set them when
# running the app outside compose (DB_USER/DB_PASSWORD then hold the application role).
DB_MIGRATION_USER=sensor
DB_MIGRATION_PASSWORD=sensor_dev_pw

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pw
KEYCLOAK_HOST_PORT=8180
DEMO_USER_PASSWORD=demo_dev_pw
ALPHA_INGEST_CLIENT_SECRET=alpha-ingest-dev-secret
BETA_INGEST_CLIENT_SECRET=beta-ingest-dev-secret
# Secret of the sensor-platform-provisioner client the app uses to create per-device clients.
PROVISIONER_CLIENT_SECRET=provisioner-dev-secret

# App
APP_HOST_PORT=8080

# Prometheus / Grafana
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_pw

# Consumer
CONSUMER_TOPICS=tenant-alpha.readings,tenant-beta.readings
CONSUMER_GROUP_ID=sensor-readings-consumer
